datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Reference / structural entities ----------
//
// Chave de identidade da PNP é sempre por NOME (não existe código numérico
// de câmpus/curso nos exports reais) — ver Instituicao.sigla/Unidade.nome.

model Instituicao {
  id                            Int                             @id @default(autoincrement())
  sigla                         String                          @unique
  nome                          String
  organizacaoAcademica          String
  regiao                        String
  uf                            String
  estado                        String
  unidades                      Unidade[]
  fatos                         FatoIndicador[]
  rappAnual                     RappAnual[]
  eficienciaAcademicaAnual      EficienciaAcademicaAnual[]
  custeioDistribuidoOficial     CusteioDistribuidoOficial[]
  assistenciaDistribuidoOficial AssistenciaDistribuidoOficial[]
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
}

model Unidade {
  id                         Int                             @id @default(autoincrement())
  nome                       String
  instituicaoId              Int
  instituicao                Instituicao                     @relation(fields: [instituicaoId], references: [id])
  /// Ano de criação do câmpus — cadastro manual (não existe em nenhum arquivo PNP ingerido),
  /// usado só para o Piso Mínimo por Câmpus Novo (ver aplicarPisoMinimoCampusNovo.ts).
  anoCriacao                 Int?
  fatos                      FatoIndicador[]
  matriculasTotalEqualizadas MatriculaTotalEqualizadaAnual[]
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt

  @@unique([instituicaoId, nome])
  @@index([instituicaoId])
}

// ---------- Ingested facts / audit trail ----------

enum PnpFileType {
  DADOS_GERAIS
  SITUACAO_MATRICULA
  CLASSIFICACAO_RACIAL_RENDA_SEXO
  PERCENTUAIS_LEGAIS
  RESERVA_VAGAS
  OFERTA_VAGAS_NOTURNAS
  RELACAO_INSCRITOS_VAGAS
  TAXA_EVASAO
  EFICIENCIA_ACADEMICA
  RELACAO_ALUNO_PROFESSOR_RAP
  INDICE_VERTICALIZACAO
  TAXA_OCUPACAO
  PROFESSORES_POR_INSTITUICAO
  TECNICOS_ADM_NIVEL
  TITULACAO_DOCENTE
  INDICADORES_GASTOS
  PANORAMA_ORCAMENTARIO
  CARGOS_CARREIRA
}

enum BatchStatus {
  PENDING
  VALIDATING
  VALIDATED_WITH_WARNINGS
  FAILED_VALIDATION
  PERSISTED
}

/// Duas fontes oficiais documentam faixas/pesos de IEA diferentes — nenhuma é descartada, o
/// sistema mantém as duas disponíveis e deixa o usuário escolher qual usar em cada ano/cálculo
/// (ver src/calculation-engine/constants/qualidadeEficiencia.constants.ts para as tabelas em si).
enum EstrategiaFaixasIea {
  /// Padrão. Faixas da planilha-modelo oficial do ciclo orçamentário de 2026 (seção 2.1 de
  /// docs/pnp-matriz/Metodologia_Matriz_Orcamentaria_CONIF.md).
  PLANILHA_2026
  /// Faixas do livro "A Matriz Orçamentária da Rede Federal de EPCT" (CONIF/Forplan, 2025) — pode
  /// divergir da planilha-modelo do ciclo vigente.
  FORPLAN_2025
}

model IngestionBatch {
  id               Int             @id @default(autoincrement())
  status           BatchStatus     @default(PENDING)
  uploadedByEmail  String?
  originalFilename String
  fileType         PnpFileType
  detectedEncoding String?
  checksum         String
  rowCount         Int?
  validationReport Json?
  createdAt        DateTime        @default(now())
  completedAt      DateTime?
  fatos            FatoIndicador[]
  yearDigests      IngestionYearDigest[]

  @@index([fileType, status])
  @@index([checksum])
}

/// Fato genérico: uma linha por (medida, dimensões) extraída de um arquivo
/// PNP. O grão real varia por fileType (Instituição-only, +Unidade,
/// +Unidade+Curso, etc) — unidadeId fica nullable e qualquer dimensão além
/// de ano/instituição/unidade vai em dimensoesExtra. `medida` é o nome PNP
/// literal (ex: "Matrícula Equivalente | Geral", "RAP | RAP").
model FatoIndicador {
  id               Int            @id @default(autoincrement())
  ingestionBatchId Int
  ingestionBatch   IngestionBatch @relation(fields: [ingestionBatchId], references: [id])
  fileType         PnpFileType
  ano              Int
  instituicaoId    Int
  instituicao      Instituicao    @relation(fields: [instituicaoId], references: [id])
  unidadeId        Int?
  unidade          Unidade?       @relation(fields: [unidadeId], references: [id])
  dimensoesExtra   Json?
  medida           String
  valor            Decimal        @db.Decimal(18, 6)
  createdAt        DateTime       @default(now())

  @@index([fileType, medida, ano])
  @@index([fileType])
  // Necessário para a importação incremental apagar um ano isolado
  // (`WHERE fileType = ? AND ano = ?`). O índice `[fileType, medida, ano]` acima NÃO serve para
  // isso: com `medida` no meio, filtrar por fileType+ano pula a coluna do meio e o MySQL cai em
  // varredura completa (medido: `type: ALL`, 1,2 milhão de linhas).
  @@index([fileType, ano])
  @@index([unidadeId])
  @@index([instituicaoId])
  @@index([ingestionBatchId])
}

/// Impressão digital do conteúdo de cada (tipo de arquivo, ano) já importado, para a importação
/// incremental: os exports da PNP são cumulativos (o arquivo de um ano traz também todos os
/// anteriores — auditado em 2026-08-28: os 18 tipos cobrem de 7 a 13 anos cada), então reimportar o
/// arquivo inteiro reescreve ~87% de dados idênticos. Guardando o digest de cada ano, o sistema
/// compara antes de gravar e só reescreve os anos que realmente mudaram.
///
/// O digest é sobre o conteúdo, não sobre "qual é o ano mais novo": se a PNP reprocessar e corrigir
/// um ano antigo, o digest daquele ano muda e ele é reimportado sozinho. Assumir "só importa o ano
/// novo" deixaria uma revisão histórica passar despercebida.
model IngestionYearDigest {
  id               Int            @id @default(autoincrement())
  fileType         PnpFileType
  ano              Int
  /// SHA-256 das linhas daquele ano, já mapeadas (independe de encoding e da ordem das colunas).
  digest           String         @db.Char(64)
  /// Linhas do CSV e fatos gravados naquele ano — exibidos na tela de upload.
  rowCount         Int
  factCount        Int
  /// Última importação que gravou este ano, para auditoria.
  ingestionBatchId Int
  ingestionBatch   IngestionBatch @relation(fields: [ingestionBatchId], references: [id])
  updatedAt        DateTime       @updatedAt

  @@unique([fileType, ano])
  @@index([ingestionBatchId])
}

/// Marca correções pontuais de dados já aplicadas em `FatoIndicador` (ex.: bug de escala 100x em
/// PercentuaisLegais.csv) para que a migration correspondente seja idempotente — não é possível
/// detectar "já corrigido" só pelo valor (faixas de valor corrigido e ainda-inflado se sobrepõem),
/// então cada correção grava aqui sua chave antes de terminar; a migration confere esta tabela
/// antes de aplicar o UPDATE de novo.
model DataFixLog {
  id        String   @id
  appliedAt DateTime @default(now())
}

// ---------- Calculation run outputs ----------

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BlocoTipo {
  FUNCIONAMENTO
  REITORIAS
  QUALIDADE_EFICIENCIA
  ASSISTENCIA_ESTUDANTIL
  ANUIDADE_CONIF
  CUSTEIO_OFICIAL
  ASSISTENCIA_OFICIAL
}

enum CalculationOrigem {
  SIMULACAO
  OFICIAL
}

model CalculationRun {
  id                 Int                 @id @default(autoincrement())
  status             RunStatus           @default(RUNNING)
  origem             CalculationOrigem   @default(SIMULACAO)
  ingestionBatchIds  Json
  parametersSnapshot Json
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  errorMessage       String?             @db.Text
  results            CalculationResult[]

  @@index([status])
  @@index([origem])
}

model CalculationResult {
  id        Int            @id @default(autoincrement())
  runId     Int
  run       CalculationRun @relation(fields: [runId], references: [id])
  campusId  Int?
  cursoId   Int?
  bloco     BlocoTipo
  metrica   String
  valor     Decimal        @db.Decimal(18, 6)
  /// "Memória de cálculo": share, band/peso, totais de rede usados para chegar em `valor` — para fins didáticos (ver runCalculation.ts).
  detalhe   Json?
  createdAt DateTime       @default(now())

  @@index([runId, bloco])
  @@index([campusId])
}

/// Orçamento total oficial de um ano — definido pelo administrador, usado como Custeio (Ação 20RL)
/// no cálculo de todas as instituições com dados PNP disponíveis (ver CalculationRun.origem).
model OrcamentoAnual {
  id                         Int                 @id @default(autoincrement())
  ano                        Int                 @unique
  valorTotal                 Decimal             @db.Decimal(18, 2)
  /// Dedução aplicada sobre `valorTotal` (Custeio 20RL Bruto) ANTES de dividir em Funcionamento
  /// 80% / Reitorias 10% / Qualidade e Eficiência 10% — corresponde ao "Ajuste" de DADOS BASE!M26
  /// da planilha-modelo CONIF, calibrado ali contra uma Assistência estimada por IPCA (diferente da
  /// Assistência real negociada em `valorAssistenciaEstudantil`, já usada corretamente pelo sistema
  /// — ver aba VALOR SPO da planilha). Guardar aqui o valor já resolvido contra os números reais do
  /// sistema (não o valor bruto de DADOS BASE!M26), para não descontar a Assistência em dobro —
  /// validado no Prompt 10 batendo o RAP oficial a 0% para as 41 instituições CONIF em 2026.
  ajuste                     Decimal             @default(0) @db.Decimal(18, 2)
  /// Orçamento da Ação 2994 (Assistência Estudantil / PNAES) do ano — isolado do Custeio 20RL,
  /// distribuído pelo Bloco de Assistência Estudantil (ver blocoAssistenciaEstudantil.ts).
  valorAssistenciaEstudantil Decimal             @default(0) @db.Decimal(18, 2)
  /// Percentual (0-100) da anuidade CONIF, calculado sobre o Custeio (20RL) já distribuído de cada
  /// instituição — informativo, não deduzido do valor que a instituição recebe (ver anuidadeConif.ts).
  percentualAnuidade         Decimal             @default(0) @db.Decimal(7, 4)
  /// Piso mínimo em R$ do Bloco Funcionamento para câmpus novos (criados a partir de 2018), já com o
  /// IPCA do ano aplicado externamente (não calculado pelo sistema) — 0 desativa a regra. Ver
  /// aplicarPisoMinimoCampusNovo.ts e Unidade.anoCriacao.
  pisoMinimoCampusNovo       Decimal             @default(0) @db.Decimal(18, 2)
  /// Qual tabela de faixas/pesos de IEA usar no cálculo oficial deste ano — nenhuma das duas é
  /// descartada, esta escolha só decide qual delas enquadra o IEA (ver calcularBlocoIea.ts).
  estrategiaFaixasIea        EstrategiaFaixasIea @default(PLANILHA_2026)
  updatedAt                  DateTime            @updatedAt
}

/// Matrícula Total equalizada por câmpus/ano (colunas Q/R/S/T de "COMPLETO PROPOSTA" na planilha
/// oficial da CONIF) — publicada pela CONIF, confirmado que NÃO é deriveável dos CSVs públicos da
/// PNP (ver src/calculation-engine/matriculaTotalEqualizada.ts). Cadastro manual/importado por
/// ano-base: ao contrário de Unidade.anoCriacao, muda a cada ciclo orçamentário. JÁ USADO no cálculo
/// (runCalculation.ts, resolverMatriculaPonderada): quando existe registro para o câmpus/anoOficial,
/// substitui o placeholder ("Matrícula Equivalente | Geral" da PNP) no Bloco Funcionamento/Reitorias;
/// sem registro, o câmpus continua no placeholder (ver fonteMatricula em TabelaDistribuicao.tsx).
model MatriculaTotalEqualizadaAnual {
  id                                 Int      @id @default(autoincrement())
  unidadeId                          Int
  unidade                            Unidade  @relation(fields: [unidadeId], references: [id])
  ano                                Int
  matriculaTotalPresencialEqualizada Decimal  @db.Decimal(18, 5)
  matriculaTotalEadEqualizada        Decimal  @db.Decimal(18, 5)
  matriculaTotalEadMoocEqualizada    Decimal  @db.Decimal(18, 5)
  matriculaTotalEadFpEqualizada      Decimal  @db.Decimal(18, 5)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  @@unique([unidadeId, ano])
  @@index([ano])
}

/// RAP Presencial oficial (RAPP, coluna N de "INDICADORES") por instituição/ano — publicado pela
/// CONIF, também confirmado não-deriveável da PNP. Cadastro manual/importado por ano-base. JÁ USADO
/// no cálculo (runCalculation.ts): quando existe registro para a instituição/anoOficial, substitui a
/// aproximação via TaxaEvasao.csv em calcularBlocoRap.ts (prioridade: override do simulador > este
/// valor oficial > aproximação); ver campo `fonte` em TabelaDistribuicao.tsx para qual foi usada.
model RappAnual {
  id            Int         @id @default(autoincrement())
  instituicaoId Int
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  ano           Int
  rapp          Decimal     @db.Decimal(18, 6)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([instituicaoId, ano])
  @@index([ano])
}

/// Conclusão/Evasão/Retenção de Ciclo e Eficiência Acadêmica (INDICADORES!G:J) por instituição —
/// publicado pela CONIF, mesma situação de MatriculaTotalEqualizadaAnual/RappAnual: não é
/// deriveável somando Concluídos/Evadidos/Retidos de EficienciaAcademica.csv por instituição (a
/// Portaria SETEC/MEC 646/2022 exclui cursos FIC do "ciclo", mas o CSV da PNP não distingue tipo de
/// curso — testado, confirma divergência real contra INDICADORES!G:J, não é bug de fórmula
/// corrigível com os dados que a PNP disponibiliza). Cadastro manual/importado por ano-base. JÁ
/// USADO no cálculo (runCalculation.ts): quando existe registro para a instituição/anoOficial,
/// substitui por completo a agregação aproximada em calcularBlocoIea.ts (prioridade: override do
/// simulador > este valor oficial > agregação aproximada, com o erro de até ~53pp já documentado).
model EficienciaAcademicaAnual {
  id                  Int         @id @default(autoincrement())
  instituicaoId       Int
  instituicao         Instituicao @relation(fields: [instituicaoId], references: [id])
  ano                 Int
  conclusaoCiclo      Decimal     @db.Decimal(18, 6)
  evasaoCiclo         Decimal     @db.Decimal(18, 6)
  retencaoCiclo       Decimal     @db.Decimal(18, 6)
  eficienciaAcademica Decimal     @db.Decimal(18, 6)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([instituicaoId, ano])
  @@index([ano])
}

/// Custeio (Funcionamento+Reitoria+Qualidade e Eficiência) FINAL distribuído por instituição,
/// publicado pela CONIF em `VALOR SPO` — já vem com o complemento da trava de não-decréscimo
/// embutido (Art. 7º Portaria SETEC/MEC nº 51/2018: nenhuma instituição pode receber menos que no
/// exercício anterior). Este sistema NÃO reimplementa o algoritmo da trava — importa o valor final
/// diretamente enquanto houver planilha oficial publicada para o ano (ver calcularDistribuicaoOficialAction).
model CusteioDistribuidoOficial {
  id                 Int         @id @default(autoincrement())
  instituicaoId      Int
  instituicao        Instituicao @relation(fields: [instituicaoId], references: [id])
  ano                Int
  custeioOficial     Decimal     @db.Decimal(18, 6)
  /// Custeio calculado pela CONIF ANTES da trava de não-decréscimo (aba COMPARATIVO, coluna AF) —
  /// permite calcular o complemento REAL (custeioOficial - custeioBaseOficial) direto da planilha,
  /// sem depender do nosso próprio cálculo por fórmula. Opcional: nem todo import necessariamente traz
  /// essa coluna (ver importarOrcamentoDistribuidoOficialAction).
  custeioBaseOficial Decimal?    @db.Decimal(18, 6)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([instituicaoId, ano])
  @@index([ano])
}

/// Assistência Estudantil (Ação 2994) FINAL distribuída por instituição, publicado pela CONIF em
/// `VALOR SPO` — mesma situação de CusteioDistribuidoOficial (já com o complemento da trava
/// embutido, importado diretamente, não recalculado).
model AssistenciaDistribuidoOficial {
  id                     Int         @id @default(autoincrement())
  instituicaoId          Int
  instituicao            Instituicao @relation(fields: [instituicaoId], references: [id])
  ano                    Int
  assistenciaOficial     Decimal     @db.Decimal(18, 6)
  /// Assistência calculada pela CONIF ANTES da trava de não-decréscimo (aba COMPARATIVO, coluna AK)
  /// — mesma finalidade de CusteioDistribuidoOficial.custeioBaseOficial.
  assistenciaBaseOficial Decimal?    @db.Decimal(18, 6)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([instituicaoId, ano])
  @@index([ano])
}

/// Em qual dos quatro "baldes" de repasse uma matrícula entra. A PNP só distingue duas modalidades
/// (Presencial e a Distância); é a fonte de financiamento/programa que separa a Distância em três,
/// com pesos bem diferentes — ver ComposicaoRepasseAnual.
enum CategoriaRepasse {
  PRESENCIAL
  EAD
  EAD_MOOC
  EAD_FP
}

/// Regra oficial que classifica cada par (Modalidade de Ensino × Fonte de Financiamento) da PNP numa
/// categoria de repasse e define o peso daquela categoria — publicada pela CONIF a cada ciclo, na
/// planilha "Composição de Repasse".
///
/// Existe porque **os pesos mudam entre ciclos**: em 2026 o EAD MOOC valia 0,8 e em 2027 passou a
/// valer 0,08 (dez vezes menos). Antes estes quatro números eram constantes no código
/// (`matriculaTotalEqualizada.ts`), o que obrigava a alterar código a cada ciclo e tornava
/// irreproduzível recalcular um ano anterior. Guardados por ano, cada cálculo usa os pesos vigentes
/// no seu próprio ciclo.
///
/// A classificação (qual programa cai em qual categoria) é guardada junto com o peso porque é ela
/// que explica o resultado — notadamente "Sem Programa Associado" em EAD, que vai para EAD FP (0,8)
/// e não para EAD (0,25). A chave de junção com os dados da PNP é `nomeFonteFinanciamento`, presente
/// em TaxaEvasao.csv (conferido: os valores batem um a um).
model ComposicaoRepasseAnual {
  id                 Int              @id @default(autoincrement())
  ano                Int
  /// Como vem da planilha: "ENSINO PRESENCIAL" ou "ENSINO A DISTANCIA".
  modalidadeEnsino   String           @db.VarChar(60)
  /// Programa/fonte, ex.: "MOOC - Aprenda Mais", "UAB (Universidade Aberta do Brasil)".
  fonteFinanciamento String           @db.VarChar(120)
  categoriaRepasse   CategoriaRepasse
  /// Multiplicador aplicado à matrícula desta categoria (1 / 0,8 / 0,25 / 0,08).
  peso               Decimal          @db.Decimal(6, 4)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // `map` explícito: o nome que o Prisma geraria sozinho passa dos 64 caracteres que o MySQL aceita.
  @@unique([ano, modalidadeEnsino, fonteFinanciamento], map: "ComposicaoRepasseAnual_ano_modalidade_fonte_key")
  @@index([ano])
}
