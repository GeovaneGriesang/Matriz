datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// Matriz2 guarda FATOS, não fórmulas.
//
// O sistema anterior tentava recalcular a Matriz de Distribuição Orçamentária a
// partir dos microdados da PNP. Não dá: três insumos centrais (Matrícula Total
// equalizada, RAPP e Eficiência Acadêmica de ciclo) não são deriváveis da PNP, e
// os dados só fecham no fim do ano, depois das seis fases de homologação.
//
// Aqui a premissa é outra: a MDO (mdo.iftm.edu.br), sistema oficial da RFEPCT,
// já publica o resultado homologado em todos os níveis de detalhe. O Matriz2 importa
// esse resultado e constrói em cima dele o que a MDO não oferece: comparação entre
// ciclos, simulação de cenários e recorte por instituição e câmpus.
//
// Por isso TODO registro aponta para uma `FonteDados`, que diz de onde o número
// veio, em que fase foi homologado, que arquivo o trouxe e o que ele abrange.
// ============================================================================

// ---------- Acesso e auditoria ----------
//
// Decisão de 2026-09-05: Consulta, Comparativo, Evasão, Simulador, Dados importados
// e a Correção manual exigem login (admin ou super-admin). Motivo: hoje 100% do que
// essas telas mostram vem de exportações da MDO, obtidas com usuário e senha
// PESSOAIS de quem administra o sistema — deixar isso público arrisca a MDO notar e
// cortar esse acesso. `OrigemDados.PNP` existe no enum de `FonteDados` para o dia em
// que houver dado público de verdade (uma versão baseada só na PNP), mas nenhuma
// tabela usa essa origem ainda. Só a tela de "primeiro acesso"/recuperação de senha
// e a página inicial (sem os números, só um convite para entrar) ficam sem login.

/// Os três papéis de quem acessa a área administrativa. `PADRAO` existe para o dia em
/// que houver uma versão pública baseada em PNP: por enquanto ele não enxerga nenhuma
/// tela com dado de verdade, só a própria conta.
enum Papel {
  /// Também cria/desativa usuários e vê a Auditoria.
  SUPER_ADMIN
  /// Acessa tudo que vem da MDO (Consulta, Comparativo, Evasão, Simulador, Dados
  /// importados, Correção manual). Não vê Usuários nem Auditoria.
  ADMIN
  /// Por enquanto, só a própria conta — ver comentário acima.
  PADRAO
}

/// Uma pessoa que pode entrar na área administrativa. O login é o e-mail.
model Usuario {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  nome               String
  /// Hash bcrypt. Nulo até a pessoa concluir o primeiro acesso (ver
  /// `CodigoVerificacao`) — sem mais "senha temporária" mostrada na criação da
  /// conta. Só o reset manual do super-admin (a reserva sem e-mail) grava aqui uma
  /// senha temporária diretamente.
  senhaHash          String?
  papel              Papel     @default(PADRAO)
  /// Desativar em vez de apagar preserva o rastro de quem fez o quê no
  /// RegistroAuditoria, que aponta para o usuário por id.
  ativo              Boolean   @default(true)
  /// Marca uma senha gerada pelo reset manual do super-admin: força a troca no
  /// próximo login, ver `requireAdminOrRedirect`. Cadastro de conta nova não usa
  /// mais isto (o primeiro acesso já pede para a pessoa escolher a própria senha).
  precisaTrocarSenha Boolean   @default(false)
  criadoEm           DateTime  @default(now())
  ultimoLoginEm      DateTime?

  sessoes            Sessao[]
  auditorias         RegistroAuditoria[]
  codigosVerificacao CodigoVerificacao[]
  valoresRecebidos   ValorRecebidoCampus[]
}

/// Tipo de código enviado por e-mail.
enum TipoCodigoVerificacao {
  PRIMEIRO_ACESSO
  RECUPERACAO_SENHA
}

/// Código de uso único enviado por e-mail (Resend), para primeiro acesso ou
/// recuperação de senha. Mesmo padrão de `Sessao`: só o HASH do código fica
/// gravado, nunca o valor em claro — quem tem o e-mail tem o código, não quem lê o
/// banco.
model CodigoVerificacao {
  id         Int                   @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario               @relation(fields: [usuarioId], references: [id])
  tipo       TipoCodigoVerificacao
  codigoHash String                @db.Char(64)
  criadoEm   DateTime              @default(now())
  expiraEm   DateTime
  /// Nulo enquanto não usado. Marcar em vez de apagar evita reenvio acidental do
  /// mesmo código já consumido.
  usadoEm    DateTime?

  @@index([usuarioId])
  @@index([expiraEm])
}

/// Uma sessão de login, guardada no banco (não só num cookie autocontido) para
/// poder ser revogada e auditada. O cookie carrega um token opaco gerado na hora do
/// login; aqui fica só o HASH desse token (SHA-256) — se o banco vazar, ninguém
/// consegue logar com o que está nesta tabela, precisa do token original.
model Sessao {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String   @unique @db.Char(64)
  criadoEm  DateTime @default(now())
  expiraEm  DateTime
  ip        String?
  userAgent String?  @db.Text

  @@index([usuarioId])
  @@index([expiraEm])
}

/// Uma ação sensível registrada. Existe para o super-admin conseguir responder
/// "quem mudou o quê, e quando" — a pergunta que a correção manual de dados
/// (`CicloOrcamento`) torna real: ela sobrescreve o que a MDO publicou, então
/// precisa ficar rastreável quem fez isso e quando.
model RegistroAuditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  /// Curto, no infinitivo, ex.: "login", "logout", "trocar_senha",
  /// "resetar_senha_usuario", "criar_usuario", "corrigir_ciclo_orcamento".
  acao      String
  /// Contexto livre da ação, ex.: { "ano": 2027 } ou { "usuarioAlvoId": 3 }.
  detalhe   Json?
  ip        String?
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
  @@index([acao])
  @@index([criadoEm])
}

// ---------- Procedência ----------

/// De onde o número veio. Exibido ao lado de cada valor na interface.
enum OrigemDados {
  /// Microdados públicos da Plataforma Nilo Peçanha.
  PNP
  /// Tabelas do painel "Dados de Ensino" da PNP, baixadas à mão por um administrador (um
  /// arquivo por aba, subaba e detalhamento). Rótulo na tela: "PNP - Extração manual".
  /// Não são os microdados e não são números da MDO: são os cubos que a própria PNP publica.
  PNP_MANUAL
  /// Exportações da Matriz de Distribuição Orçamentária, operada pelo IFTM para a RFEPCT.
  MDO_IFTM
  /// Derivado pelo próprio Matriz2 (somas, variações, simulações). Sempre rastreável às parcelas.
  CALCULADO
  /// Digitado por um administrador, para o que nenhuma fonte publica. O de menor confiança.
  ADMINISTRADOR
}

/// O que um conjunto de dados cobre. Metade do material da MDO cobre apenas uma
/// instituição; sem este campo, uma consulta de rede somaria 14 câmpus achando
/// que somou 639, e o erro não apareceria em lugar nenhum.
enum Abrangencia {
  REDE
  INSTITUICAO
  CAMPUS
}

/// As sete etapas da MDO, na ordem em que o sistema oficial as executa. Guardar a
/// fase é guardar quem homologou o número: as fases 2, 3 e 4 são homologadas por
/// cada instituição; as demais, pela própria MDO.
enum FaseMdo {
  /// 1ª (a): microdados disponibilizados pela PNP.
  F1A_OBTENCAO
  /// 1ª (b): integração dos dados na base da MDO.
  F1B_IMPORTACAO
  /// 2ª: conferência da extração, homologada por cada instituição.
  F2_CONFERENCIA_EXTRACAO
  /// 3ª: parametrização por câmpus e alunos em Regime de Internato Pleno (RIP).
  F3_PARAMETROS_CAMPUS
  /// 4ª: checagem das matrículas totais e indicadores.
  F4_CHECAGEM_MATRICULAS
  /// 5ª: geração da proposta, com todos os blocos por câmpus e instituição.
  F5_PROPOSTA
  /// 6ª: participação de cada ciclo de curso na distribuição. Em andamento no ciclo 2027.
  F6_PARTICIPACAO
}

/// Um arquivo importado, com tudo que é preciso saber para confiar (ou desconfiar)
/// dos números que vieram dele.
model FonteDados {
  id             Int          @id @default(autoincrement())
  origem         OrigemDados
  fase           FaseMdo?
  /// Ciclo orçamentário a que o dado se refere (2026, 2027), não o ano-base da PNP.
  cicloOrcamento Int
  /// Nome do arquivo de procedência, como recebido.
  arquivo        String
  /// Data que o próprio arquivo declara ("Gerado em 30/08/2026"). É a data do DADO.
  geradoEm       DateTime?
  /// Quando este sistema leu o arquivo. É a data da CARGA, diferente da anterior.
  carregadoEm    DateTime     @default(now())
  abrangencia    Abrangencia
  /// Preenchido quando `abrangencia` não é REDE: de quem são os dados.
  instituicaoId  Int?
  instituicao    Instituicao? @relation(fields: [instituicaoId], references: [id])
  /// SHA-256 do arquivo, para detectar recarga do mesmo conteúdo.
  checksum       String?      @db.Char(64)
  /// Ressalvas conhecidas, exibidas junto do dado. Ex.: a 6ª fase de 2027 ainda
  /// está "Em andamento" na MDO, então os valores podem mudar.
  ressalva       String?      @db.Text

  distribuicoesCiclo        DistribuicaoCiclo[]
  distribuicoesCampus       DistribuicaoCampus[]
  distribuicoesInstituicao  DistribuicaoInstituicao[]
  comparativos              ComparativoInstitucional[]
  conferenciasExtracao      ConferenciaExtracao[]
  conferenciasExtracaoAluno ConferenciaExtracaoAluno[]
  ciclosOrcamento           CicloOrcamento[]
  parametrosParticipacao    ParametrosParticipacao[]
  conferenciasCiclo         ConferenciaCiclo[]
  pesosEfetivos             PesoEfetivoCurso[]
  indicadoresPnp            IndicadoresPnpInstituicao[]
  pnpFatos                  PnpFato[]
  pnpOrcamentoFatos         PnpOrcamentoFato[]
  pnpExtratorFatos          PnpExtratorFato[]
  pnpMicrodadoCiclos        PnpMicrodadoCiclo[]
  pnpMicrodadoFinanceiro    PnpMicrodadoFinanceiro[]
  pnpMicrodadoServidores    PnpMicrodadoServidor[]

  @@index([cicloOrcamento, origem])
  @@index([instituicaoId])
}

// ---------- Entidades ----------

model Instituicao {
  id       Int       @id @default(autoincrement())
  sigla    String    @unique
  nome     String
  uf       String
  unidades Unidade[]

  fontes                   FonteDados[]
  distribuicoesInstituicao DistribuicaoInstituicao[]
  comparativos             ComparativoInstitucional[]
  parametrosParticipacao   ParametrosParticipacao[]
  indicadoresPnp           IndicadoresPnpInstituicao[]
  pnpEstruturas            PnpEstrutura[]
  orcamentoLoaLinhas       OrcamentoLoaLinha[]
  orcamentoLoaTotais       OrcamentoLoaTotal[]
  emendasParlamentares     EmendaParlamentar[]

  @@index([uf])
}

/// A MDO separa as unidades em três tipos na coluna TIPO da aba COMPLETO PROPOSTA:
/// `T` (linha de total da instituição), `R` (reitoria) e `C` (câmpus). Somar sem
/// filtrar por tipo duplica todos os totais, erro que já cometemos uma vez.
enum TipoUnidade {
  CAMPUS
  REITORIA
}

model Unidade {
  id            Int         @id @default(autoincrement())
  instituicaoId Int
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  nome          String
  tipo          TipoUnidade @default(CAMPUS)
  /// Ano de criação, publicado pela MDO na coluna ANO_CRIACAO. Define elegibilidade ao Piso Mínimo.
  anoCriacao    Int?

  distribuicoesCiclo        DistribuicaoCiclo[]
  distribuicoesCampus       DistribuicaoCampus[]
  conferenciasExtracao      ConferenciaExtracao[]
  conferenciasExtracaoAluno ConferenciaExtracaoAluno[]
  conferenciasCiclo         ConferenciaCiclo[]
  pnpEstruturas             PnpEstrutura[]
  valoresRecebidos          ValorRecebidoCampus[]

  @@unique([instituicaoId, nome])
  @@index([instituicaoId])
}

// ---------- Parâmetros do ciclo ----------

/// Os parâmetros que definem um ciclo orçamentário, lidos da aba DADOS BASE da 5ª fase.
///
/// O encadeamento oficial, conferido contra a planilha de 2027 e fechando ao centavo:
///
///   Valor referência (SPO)          3.077.715.770,00
///   (-) Ajuste                         89.990.947,79
///   = Valor referência                2.987.724.822,21
///   (-) Assistência Estudantil          651.560.247,20
///   = Base do rateio                  2.336.164.575,01
///       Funcionamento          80%    1.868.931.660,00
///         dos quais Piso Mínimo          37.100.000,00   (53 câmpus x R$ 700.000)
///         distribuído por matrícula   1.831.831.660,00
///       Reitorias              10%      233.616.457,50
///       Qualidade e Eficiência 10%      233.616.457,50
///         IEA 25% + RAP 25% + IAPL 50%
///
/// Como o Piso Mínimo realmente funciona, conferido linha a linha na planilha de 2027
/// (a leitura anterior, registrada aqui antes, estava errada e foi corrigida):
///
///   1. Reserva-se 53 x R$ 700.000 = R$ 37.100.000 de dentro dos 80%.
///   2. O que sobra (R$ 1.831.831.660) é distribuído por matrícula entre TODOS os
///      câmpus. É esse total que a 6ª fase publica somando os 58.242 ciclos.
///   3. Os 53 marcados recebem R$ 700.000 no lugar do que calcularam, e não somado a
///      ele. Todos os 53 ficaram exatamente em R$ 700.000, porque o calculado deles
///      somava apenas R$ 1.760.440,90 no conjunto.
///
/// Ou seja, a regra por câmpus é MAX(piso, calculado), a mesma do sistema antigo. O
/// erro dele está em NÃO reservar o piso do bolo antes de ratear: ele distribui os
/// 80% inteiros por matrícula e depois eleva quem está abaixo do piso, inflando o
/// bloco em R$ 40,4 milhões. A CONIF reserva primeiro, e por isso fecha dentro dos
/// 80% (na verdade R$ 1,76 milhão abaixo, que é a parcela que os 53 abriram mão).
///
/// A elegibilidade é uma bandeira explícita da planilha, não uma regra deduzível: ver
/// `DistribuicaoCampus.elegivelPiso`.
///
/// Outra diferença que vale registrar: a Assistência sai ANTES do rateio, e não é um
/// "ajuste". O sistema anterior embutia parte dela no ajuste e chegava à mesma base
/// por um caminho que não corresponde ao da planilha, o que tornava impossível
/// conferir parcela a parcela.
model CicloOrcamento {
  ano Int @id

  /// Valor de referência informado pela SPO (célula M23 da aba DADOS BASE).
  valorReferenciaSpo Decimal @db.Decimal(18, 2)
  /// Dedução aplicada sobre o valor de referência (M24).
  ajuste             Decimal @default(0) @db.Decimal(18, 2)
  /// Assistência Estudantil (Ação 2994), retirada antes do rateio 80/10/10 (W42).
  assistenciaTotal   Decimal @default(0) @db.Decimal(18, 2)

  /// Bloco Funcionamento, 80% da base (W29).
  funcionamentoTotal Decimal @db.Decimal(18, 2)
  /// Parcela do Funcionamento reservada ao Piso Mínimo (W28).
  pisoTotal          Decimal @default(0) @db.Decimal(18, 2)
  /// Piso por câmpus, em reais. R$ 700.000 em 2027 e em 2026.
  pisoPorCampus      Decimal @default(0) @db.Decimal(18, 2)
  /// Quantos câmpus efetivamente recebem o piso, conforme a linha de totais da planilha
  /// (53 em 2027, 55 em 2026). Não confundir com a aba EXPANSÃO, que lista 65 câmpus
  /// com portaria de criação, conjunto maior.
  campusComPiso      Int     @default(0)

  /// Bloco Reitorias, 10% da base (W32).
  reitoriasTotal           Decimal @default(0) @db.Decimal(18, 2)
  /// Bloco Qualidade e Eficiência, 10% da base (W20).
  qualidadeEficienciaTotal Decimal @default(0) @db.Decimal(18, 2)
  valorIea                 Decimal @default(0) @db.Decimal(18, 2)
  valorRap                 Decimal @default(0) @db.Decimal(18, 2)
  valorIapl                Decimal @default(0) @db.Decimal(18, 2)

  /// Valor de uma matrícula em cada balde de repasse (I29, I33, I37, I41). É o que
  /// multiplica a matrícula do câmpus para chegar ao valor dele.
  valorMatriculaPresencial Decimal? @db.Decimal(18, 6)
  valorMatriculaEad        Decimal? @db.Decimal(18, 6)
  valorMatriculaEadFp      Decimal? @db.Decimal(18, 6)
  valorMatriculaEadMooc    Decimal? @db.Decimal(18, 6)

  /// Percentual da anuidade CONIF (I21), em fração. 0,0015 é 0,15%.
  percentualAnuidade Decimal @default(0) @db.Decimal(9, 6)

  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  @@index([fonteDadosId])
}

// ---------- Distribuição, nos três níveis de detalhe que a MDO publica ----------

/// Em qual dos quatro baldes de repasse a matrícula entra. A PNP só distingue
/// presencial e a distância; é a fonte de financiamento que separa a distância em três.
enum CategoriaRepasse {
  PRESENCIAL
  EAD
  EAD_MOOC
  EAD_FP
}

/// O nível de detalhe mais fino que existe: quanto cada ciclo de curso recebe (6ª fase da MDO).
///
/// São 58.242 linhas em 2027, cobrindo 42 instituições, 639 câmpus e 1.520 cursos.
/// A soma de `valorReais` dá R$ 1.831.831.659,97, exatamente o mesmo total que se
/// obtém somando as linhas de câmpus ou as de instituição da 5ª fase. Essa
/// coincidência tripla é a melhor conferência que o conjunto oferece; vale
/// reproduzi-la como teste depois de cada carga.
model DistribuicaoCiclo {
  id           Int        @id @default(autoincrement())
  ano          Int
  unidadeId    Int
  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  /// Identificador do ciclo na MDO, estável entre exportações.
  codigoCiclo String
  ciclo       String  @db.Text
  curso       String
  areaEixo    String?
  nivel       String?
  tipoCurso   String?
  tipoOferta  String?
  turno       String?

  modalidade         String
  fonteFinanciamento String
  repasse            CategoriaRepasse

  inicio      DateTime?
  termino     DateTime?
  jubilamento DateTime?

  /// Peso do curso na matriz. Assume 1,00, 1,50, 2,00, 2,50 ou 3,75.
  pesoCursoMatriz Decimal? @db.Decimal(10, 4)
  chMinimaMec     Int?
  cargaHoraria    Int?
  chMatriz        Int?

  qtdAlunosMatriz Decimal? @db.Decimal(18, 5)
  matriculaTotal  Decimal  @db.Decimal(18, 6)

  /// Quanto este ciclo recebe.
  valorReais       Decimal  @db.Decimal(18, 6)
  icqa             Decimal? @db.Decimal(18, 6)
  valorAluno       Decimal? @db.Decimal(18, 6)
  /// Quanto o ciclo deixa de receber por evasão. Somou R$ 102.320.304,23 na rede em 2027
  /// na exportação de 2026-08-31. Atenção: na 6ª fase do IFSul de 2026-09-29 esta coluna
  /// ("Custo Evadido") mudou de definição e passou a valer, para o aluno retido, METADE
  /// do que valia antes (valor do ciclo x alunos não contabilizados / alunos, em vez do
  /// valor inteiro). Não some as duas versões.
  perdaEvasaoReais Decimal? @db.Decimal(18, 6)

  /// Só existem na 6ª fase no formato de fórmulas (IFSul, 2026-09-29); nulos na
  /// exportação da rede de 2026-08-31.
  agropecuaria            Boolean?
  /// Horas acima do mínimo do MEC (CH da matriz menos CH MEC, quando positivo).
  chExcedente             Int?
  alunosContabilizados    Decimal? @db.Decimal(18, 5)
  alunosNaoContabilizados Decimal? @db.Decimal(18, 5)
  /// Fatia do ciclo no total da instituição (0,0004 = 0,04%).
  contribuicaoInstituicao Decimal? @db.Decimal(18, 10)

  @@unique([ano, unidadeId, codigoCiclo])
  @@index([ano, unidadeId])
  @@index([ano, repasse])
  @@index([curso])
  @@index([fonteDadosId])
}

/// Nível de câmpus (linhas TIPO = C da aba COMPLETO PROPOSTA, 5ª fase). Traz todos
/// os blocos abertos, inclusive o RIP da Assistência, que nunca conseguimos derivar.
model DistribuicaoCampus {
  id           Int        @id @default(autoincrement())
  ano          Int
  unidadeId    Int
  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  /// A planilha marca com "S", na coluna Piso, os câmpus elegíveis ao Piso Mínimo:
  /// 53 em 2027 e 55 em 2026. É uma BANDEIRA da MDO, não uma regra que se deduza do
  /// ano de criação. Os 53 de 2027 foram criados entre 2022 e 2026, e existem 21
  /// câmpus criados de 2018 em diante que a planilha NÃO marca; por isso o sistema
  /// antigo, que deduzia elegibilidade de `anoCriacao >= 2018`, chegava a 67.
  elegivelPiso Boolean @default(false)

  /// Valor final do Funcionamento do câmpus (VL_MATR da aba RESUMO PROPOSTA), já com
  /// a regra do piso aplicada pela MDO. Para os 53 elegíveis de 2027 é exatamente
  /// R$ 700.000; para os demais é o valor por matrícula. Guardamos o resultado, não
  /// a fórmula: quem calcula é a MDO.
  vlMatrFinal Decimal? @db.Decimal(18, 6)

  matrPresencialAjustada Decimal? @db.Decimal(18, 6)
  matrEadAjustada        Decimal? @db.Decimal(18, 6)

  qtAlPresencial Decimal? @db.Decimal(18, 5)
  qtAlEad        Decimal? @db.Decimal(18, 5)
  qtAlMooc       Decimal? @db.Decimal(18, 5)
  qtAlEadFp      Decimal? @db.Decimal(18, 5)

  mtPresencial Decimal? @db.Decimal(18, 6)
  mtEad        Decimal? @db.Decimal(18, 6)
  mtEadMooc    Decimal? @db.Decimal(18, 6)
  mtEadFp      Decimal? @db.Decimal(18, 6)

  /// Bloco Funcionamento, aberto por modalidade.
  vlMatrizPresencial Decimal? @db.Decimal(18, 6)
  vlMatrizEad        Decimal? @db.Decimal(18, 6)
  vlMatrizEadMooc    Decimal? @db.Decimal(18, 6)
  vlMatrizEadFp      Decimal? @db.Decimal(18, 6)

  /// Bloco Assistência Estudantil, aberto por modalidade e pelo Regime de Internato Pleno.
  aePresencial Decimal? @db.Decimal(18, 6)
  aeEad        Decimal? @db.Decimal(18, 6)
  aeRip        Decimal? @db.Decimal(18, 6)

  @@unique([ano, unidadeId])
  @@index([ano])
  @@index([fonteDadosId])
}

/// Quanto um câmpus REALMENTE recebeu, digitado por um administrador. Não é o mesmo
/// número que `DistribuicaoCiclo.valorReais` (a soma por curso) ou
/// `DistribuicaoCampus.vlMatrFinal`: aqueles são o que a matriz da MDO gerou, este é
/// o que o Tesouro/MEC de fato depositou, que pode divergir por contingenciamento,
/// emenda parlamentar, ou qualquer outro motivo orçamentário fora da matriz. Por
/// isso NÃO aponta para `FonteDados`: ao contrário de todo o resto do schema, este
/// fato não vem de nenhum arquivo da MDO e não é apagado quando `npm run carregar`
/// roda de novo para o ano — é um dado independente, que só muda quando alguém edita
/// à mão em /admin/valores-recebidos.
model ValorRecebidoCampus {
  id              Int      @id @default(autoincrement())
  ano             Int
  unidadeId       Int
  unidade         Unidade  @relation(fields: [unidadeId], references: [id])
  valorRecebido   Decimal  @db.Decimal(18, 6)
  observacao      String?  @db.Text
  registradoPorId Int
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id])
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([ano, unidadeId])
  @@index([ano])
}

/// Comparativo entre ciclos, por instituição, vindo dos relatórios de Indicadores da
/// MDO (pasta "03 - Indicadores"). Fica separado de `DistribuicaoInstituicao` porque é
/// outra fonte, exportada em outra data, e porque **resolve a lacuna de 2026**: a 5ª
/// fase de 2026 saiu sem matrícula e zerou o Funcionamento, enquanto este relatório
/// traz os dois ciclos preenchidos.
///
/// Conferido em 2026-09-02: no nível de instituição bate ao centavo com a 5ª fase
/// (IFSP 2027: Matrículas 130.713.627,35 + IQE 3.188.215,39 = os R$ 133.901.842,74 de
/// `matrizCusteio`), e a participação percentual soma 100% nos dois anos.
///
/// ATENÇÃO, e é o motivo de só guardarmos o nível de instituição: o arquivo irmão
/// `comparativo-institucional-completo.xlsx`, que desce a câmpus, tem os valores
/// **trocados de unidade**. Onze câmpus receberam o valor de um "irmão" cujo nome é
/// uma extensão do seu, e esse irmão sumiu da lista (no IFSul, CAMPUS PELOTAS ficou
/// com os R$ 5.156.741,72 do CAMPUS PELOTAS VISCONDE DA GRAÇA). É a mesma armadilha
/// de casar câmpus por nome que já nos pegou antes; aqui ela está do lado da MDO.
model ComparativoInstitucional {
  id            Int         @id @default(autoincrement())
  ano           Int
  instituicaoId Int
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  fonteDadosId  Int
  fonteDados    FonteDados  @relation(fields: [fonteDadosId], references: [id])

  /// Bloco Funcionamento (a MDO chama de "Matrículas" nestes relatórios).
  matriculas Decimal? @db.Decimal(18, 6)
  /// Índice de Qualidade e Eficiência, o bloco de 10%.
  iqe        Decimal? @db.Decimal(18, 6)
  /// Assistência Estudantil.
  ae         Decimal? @db.Decimal(18, 6)
  /// Soma dos três, como a MDO publica.
  totalSpo   Decimal? @db.Decimal(18, 6)

  /// Fatia da instituição no orçamento da rede, em pontos percentuais (2,19 = 2,19%).
  /// Some 100 entre as instituições do ciclo, ao contrário da coluna PORCENTAGEM da
  /// aba RESUMO PROPOSTA, cujo significado segue desconhecido.
  participacaoPercentual Decimal? @db.Decimal(9, 4)
  posicaoRede            Int?

  @@unique([ano, instituicaoId])
  @@index([ano])
  @@index([fonteDadosId])
}

/// Conferência da Extração da PNP (2ª fase da MDO), homologada por cada instituição.
/// Traz, por câmpus, a matrícula aberta por situação, a evasão aberta por motivo e a
/// distribuição de renda familiar das famílias dos alunos.
///
/// Abrangência INSTITUICAO: só temos o arquivo do IFSul. É o primeiro conjunto do
/// sistema que não cobre a rede, e a razão de `FonteDados.abrangencia` existir.
///
/// Ressalva registrada na carga: as pastas de 2026 e 2027 contêm o MESMO arquivo,
/// ambos nomeados `..._2025`, quando o ciclo 2026 deveria usar a PNP de 2024. O
/// seletor de ano não pegou na exportação, então os dois ciclos ficam com os números
/// da PNP de 2025 até uma reexportação.
model ConferenciaExtracao {
  id           Int        @id @default(autoincrement())
  ano          Int
  unidadeId    Int
  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  /// Matrículas por situação, como a PNP as classifica.
  concluido     Decimal? @db.Decimal(18, 4)
  integralizado Decimal? @db.Decimal(18, 4)
  emCurso       Decimal? @db.Decimal(18, 4)
  retido        Decimal? @db.Decimal(18, 4)
  /// "Matriz": a matrícula que efetivamente entra no cálculo.
  matriz        Decimal? @db.Decimal(18, 4)

  /// Evasão aberta por motivo. Somada, é o numerador da taxa de evasão.
  abandono      Decimal? @db.Decimal(18, 4)
  desligado     Decimal? @db.Decimal(18, 4)
  reprovado     Decimal? @db.Decimal(18, 4)
  transfExterna Decimal? @db.Decimal(18, 4)
  transfInterna Decimal? @db.Decimal(18, 4)

  /// Renda familiar em salários mínimos, quantidade de alunos por faixa. Alimenta a
  /// Assistência Estudantil, que é rateada por renda.
  rendaNaoDeclarada Decimal? @db.Decimal(18, 4)
  rendaAte05        Decimal? @db.Decimal(18, 4)
  renda05a10        Decimal? @db.Decimal(18, 4)
  renda10a15        Decimal? @db.Decimal(18, 4)
  renda15a25        Decimal? @db.Decimal(18, 4)
  renda25a35        Decimal? @db.Decimal(18, 4)
  rendaAcima35      Decimal? @db.Decimal(18, 4)
  rendaTotal        Decimal? @db.Decimal(18, 4)
  /// Índice de renda ponderada que a MDO calcula a partir das faixas acima.
  rendaPonderada    Decimal? @db.Decimal(18, 6)

  @@unique([ano, unidadeId])
  @@index([ano])
  @@index([fonteDadosId])
}

/// Conferência da Extração da PNP (2ª fase), no nível MAIS FINO que existe: um
/// registro por matrícula de aluno. 206.700 linhas para o IFSul, em cada um dos dois
/// ciclos.
///
/// ATENÇÃO — NUNCA consultar este model a partir de uma rota, página ou API pública.
/// `matriculaAluno` é um identificador pseudonimizado (não é nome nem CPF), mas
/// combinado com câmpus + curso + datas + faixa de renda pode reidentificar um aluno
/// em turmas pequenas — é dado pessoal sob a LGPD. Decisão do usuário em 2026-09-03:
/// carregar para auditoria e conferência interna, nunca expor publicamente. Só é lido
/// por scripts administrativos (`scripts/carregar.ts`), jamais por `src/app/**`.
///
/// Ressalva da carga: a pasta de 2027 tem, por engano da própria MDO, um arquivo
/// chamado "Matriz Distribuição Orçamentária 2027.xlsx" (nome de outro relatório,
/// conteúdo certo — ver `caminhos.conferenciaExtracaoAluno`). E o conteúdo é
/// IDÊNTICO ao da pasta de 2026 (mesmas 206.700 linhas, mesmos valores): é o mesmo
/// bug do seletor de ano que já afeta `ConferenciaExtracao` (agregada) e
/// `ComparativoInstitucional`.
model ConferenciaExtracaoAluno {
  id           Int        @id @default(autoincrement())
  ano          Int
  unidadeId    Int
  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  /// Identificador do ciclo de curso ao qual a matrícula pertence (mesmo conceito de
  /// `DistribuicaoCiclo.codigoCiclo`, aqui a granularidade é o aluno dentro do ciclo).
  codigoCiclo   String
  nomeCiclo     String  @db.Text
  financiamento String
  tipoCurso     String
  curso         String
  areaEixo      String?
  agropecuaria  Boolean @default(false)
  tipoOferta    String?

  inicio          DateTime?
  previstoTermino DateTime?
  jubilamento     DateTime?

  chHoraria    Int?
  chHorariaMec Int?
  chMatriz     Int?

  /// Identificador PSEUDONIMIZADO do aluno (não é nome nem CPF), persistente entre
  /// registros do mesmo aluno. Ver o aviso de privacidade no topo deste model.
  matriculaAluno String

  /// Faixa de Renda Familiar Per capita (RFP), como a MDO publica (ex.: "0,5<RFP<=1").
  renda String?

  situacaoMatricula String?
  situacaoMatriz    String?

  @@index([ano, unidadeId])
  @@index([fonteDadosId])
  @@index([matriculaAluno])
}

/// Nível de instituição (linhas TIPO = T, mais os indicadores da aba INDICADORES).
model DistribuicaoInstituicao {
  id            Int         @id @default(autoincrement())
  ano           Int
  instituicaoId Int
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  fonteDadosId  Int
  fonteDados    FonteDados  @relation(fields: [fonteDadosId], references: [id])

  /// Bloco Funcionamento somado dos câmpus.
  vlMatr        Decimal? @db.Decimal(18, 6)
  /// Bloco Qualidade e Eficiência, repartido em IEA 25%, RAP 25% e IAPL 50%.
  vlIea         Decimal? @db.Decimal(18, 6)
  vlRap         Decimal? @db.Decimal(18, 6)
  vlIapl        Decimal? @db.Decimal(18, 6)
  matrizCusteio Decimal? @db.Decimal(18, 6)
  matrizAe      Decimal? @db.Decimal(18, 6)
  anuidadeConif Decimal? @db.Decimal(18, 6)
  /// Coluna PORCENTAGEM da aba RESUMO PROPOSTA, guardada como vem. **O significado
  /// ainda não está confirmado**: não é participação na rede, porque a soma das 42
  /// instituições dá 4,87 (487%), não 1. Os valores vão de 2,4% (IFSP) a 21,0%
  /// (IFAC), o que sugere variação contra o ciclo anterior, mas a planilha não
  /// rotula a coluna e não dá para afirmar. Não usar em tela até confirmar com a
  /// CONIF ou com o IFTM.
  porcentagem   Decimal? @db.Decimal(12, 8)

  /// Indicadores da aba INDICADORES, já homologados pelas instituições na 4ª fase.
  /// NÃO recalcular: é exatamente o que o sistema antigo não conseguia derivar da PNP
  /// (a aproximação do IEA chegava a errar 53 pontos percentuais em redes grandes).
  ieaConclusao  Decimal? @db.Decimal(18, 6)
  ieaEvasao     Decimal? @db.Decimal(18, 6)
  ieaRetencao   Decimal? @db.Decimal(18, 6)
  ieaEficiencia Decimal? @db.Decimal(18, 6)
  ieaPonderado  Decimal? @db.Decimal(18, 6)
  ieaEqualizado Decimal? @db.Decimal(18, 6)

  /// Relação Aluno Professor. `rapPresencial` é o RAPP oficial, que o sistema antigo
  /// aproximava por TaxaEvasao.csv.
  rapPresencial    Decimal? @db.Decimal(18, 6)
  rapMecPresencial Decimal? @db.Decimal(18, 6)
  rapEquivalente   Decimal? @db.Decimal(18, 6)
  rapPonderado     Decimal? @db.Decimal(18, 6)
  rapEqualizado    Decimal? @db.Decimal(18, 6)

  /// Atendimento aos Percentuais Legais, aberto nos três percentuais que o compõem.
  aplTecnico           Decimal? @db.Decimal(18, 6)
  aplTecnicoPonderado  Decimal? @db.Decimal(18, 6)
  aplFormacaoProfessor Decimal? @db.Decimal(18, 6)
  ialPonderado         Decimal? @db.Decimal(18, 6)
  aplProeja            Decimal? @db.Decimal(18, 6)
  aplProejaPonderado   Decimal? @db.Decimal(18, 6)
  ialEqualizado        Decimal? @db.Decimal(18, 6)

  /// Matrícula Equivalente da instituição, base dos indicadores acima.
  matrEquivalente Decimal? @db.Decimal(18, 6)

  @@unique([ano, instituicaoId])
  @@index([ano])
  @@index([fonteDadosId])
}

/// Os parâmetros que a 6ª fase de UMA instituição carrega na aba "Parâmetros": o
/// orçamento, os descontos e as matrículas totais da REDE, tudo que é preciso para
/// transformar a Matrícula Total de um ciclo em reais (valor da matrícula x matrícula).
///
/// Guardar isto, e não só o resultado por ciclo, é o que permite o Simulador de curso:
/// dado um curso hipotético, a Matrícula Total sai da regra em `lib/mdo/matriculaTotal`
/// e o valor da matrícula sai daqui.
///
/// ATENÇÃO: em 2026-09-29 estes parâmetros (ajuste de R$ 110,7 mi, valor da matrícula
/// presencial de R$ 1.228,90) NÃO coincidiam com os da 5ª fase do mesmo dia (ajuste de
/// R$ 90,0 mi, R$ 1.154,24). São fotografias de momentos diferentes da MDO; quem compara
/// o total do IFSul entre as fases precisa saber disso.
model ParametrosParticipacao {
  id            Int         @id @default(autoincrement())
  ano           Int
  instituicaoId Int
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  fonteDadosId  Int
  fonteDados    FonteDados  @relation(fields: [fonteDadosId], references: [id])

  /// Período da PNP usado como ano-base (ex.: 2025-01-01 a 2025-12-31 para o ciclo 2027).
  periodoInicio DateTime @db.Date
  periodoFim    DateTime @db.Date

  valorOrcamento          Decimal @db.Decimal(18, 2)
  ajuste                  Decimal @db.Decimal(18, 2)
  assistenciaEstudantil   Decimal @db.Decimal(18, 2)
  novosCampi              Decimal @db.Decimal(18, 2)
  percentualFuncionamento Decimal @db.Decimal(9, 6)

  /// Matrícula Total da rede inteira, por modalidade de repasse.
  matriculasPresencial Decimal @db.Decimal(18, 6)
  matriculasEad        Decimal @db.Decimal(18, 6)
  matriculasEadMooc    Decimal @db.Decimal(18, 6)
  matriculasEadFp      Decimal @db.Decimal(18, 6)

  /// Peso de cada modalidade sobre o presencial (1; 0,25; 0,08; 0,8).
  pesoEad     Decimal @db.Decimal(9, 6)
  pesoEadMooc Decimal @db.Decimal(9, 6)
  pesoEadFp   Decimal @db.Decimal(9, 6)

  /// Derivados dos campos acima (a planilha os calcula por fórmula): o valor em reais de
  /// uma matrícula em cada modalidade.
  valorMatriculaPresencial Decimal @db.Decimal(18, 6)
  valorMatriculaEad        Decimal @db.Decimal(18, 6)
  valorMatriculaEadMooc    Decimal @db.Decimal(18, 6)
  valorMatriculaEadFp      Decimal @db.Decimal(18, 6)

  @@unique([ano, instituicaoId])
  @@index([fonteDadosId])
}

/// Conferência da Extração da PNP (2ª fase) no grão de CICLO DE CURSO: para cada ciclo
/// de cada câmpus, a matrícula aberta por situação (concluída, retida, evadida por
/// motivo...) e por faixa de renda familiar. Só existe para o IFSul.
///
/// É o que falta para explicar POR QUE um ciclo entrou na matriz com o valor que entrou:
/// a 6ª fase diz quanto o ciclo recebe; esta diz quantos concluíram, ficaram retidos ou
/// evadiram, e de que faixa de renda são. Liga-se à `DistribuicaoCiclo` pelo
/// `codigoCiclo`.
///
/// O ano do arquivo é o da PNP (2024 para o ciclo 2026, 2025 para o 2027), e agora existe
/// um arquivo para cada, o que a extração por unidade e por aluno não tinha (as duas
/// pastas traziam o mesmo arquivo).
model ConferenciaCiclo {
  id           Int        @id @default(autoincrement())
  ano          Int
  unidadeId    Int
  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  codigoCiclo   String
  nomeCiclo     String  @db.Text
  modalidade    String
  financiamento String
  tipoCurso     String
  curso         String
  areaEixo      String?
  agropecuaria  Boolean @default(false)
  tipoOferta    String?

  inicio          DateTime?
  previstoTermino DateTime?
  chHoraria       Int?
  chHorariaMec    Int?
  chMatriz        Int?

  /// Situação da matrícula, em quantidade de alunos.
  concluida     Decimal @default(0) @db.Decimal(18, 4)
  integralizada Decimal @default(0) @db.Decimal(18, 4)
  emFluxo       Decimal @default(0) @db.Decimal(18, 4)
  retido        Decimal @default(0) @db.Decimal(18, 4)
  abandono      Decimal @default(0) @db.Decimal(18, 4)
  cancelada     Decimal @default(0) @db.Decimal(18, 4)
  desligada     Decimal @default(0) @db.Decimal(18, 4)
  reprovada     Decimal @default(0) @db.Decimal(18, 4)
  substituido   Decimal @default(0) @db.Decimal(18, 4)
  transfExterna Decimal @default(0) @db.Decimal(18, 4)
  transfInterna Decimal @default(0) @db.Decimal(18, 4)
  qtdMatriculas Decimal @default(0) @db.Decimal(18, 4)

  /// Faixa de renda familiar per capita, em salários mínimos.
  rendaNaoDeclarada Decimal @default(0) @db.Decimal(18, 4)
  rendaAte05        Decimal @default(0) @db.Decimal(18, 4)
  renda05a10        Decimal @default(0) @db.Decimal(18, 4)
  renda10a15        Decimal @default(0) @db.Decimal(18, 4)
  renda15a25        Decimal @default(0) @db.Decimal(18, 4)
  renda25a35        Decimal @default(0) @db.Decimal(18, 4)
  rendaAcima35      Decimal @default(0) @db.Decimal(18, 4)

  @@unique([ano, unidadeId, codigoCiclo, financiamento])
  @@index([ano, unidadeId])
  @@index([fonteDadosId])
}

/// Indicadores da PNP por instituição, da aba INDICADORES do arquivo de ciclos da 2ª fase.
/// Cobre a REDE inteira (42 instituições), mesmo o arquivo sendo do IFSul: é a única
/// aba que não filtra por instituição. Não substitui `DistribuicaoInstituicao` (que vem
/// da 5ª fase e é a que fecha com o orçamento); serve para conferir os dois.
model IndicadoresPnpInstituicao {
  id            Int         @id @default(autoincrement())
  ano           Int
  instituicaoId Int
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  fonteDadosId  Int
  fonteDados    FonteDados  @relation(fields: [fonteDadosId], references: [id])

  ieaConclusao  Decimal? @db.Decimal(9, 4)
  ieaEvasao     Decimal? @db.Decimal(9, 4)
  ieaRetencao   Decimal? @db.Decimal(9, 4)
  ieaEficiencia Decimal? @db.Decimal(9, 4)

  rapPresencial        Decimal? @db.Decimal(12, 4)
  matriculaEqRap       Decimal? @db.Decimal(18, 4)
  professorEquivalente Decimal? @db.Decimal(18, 4)

  meTecnicos Decimal? @db.Decimal(9, 4)
  meFormacao Decimal? @db.Decimal(9, 4)
  meProeja   Decimal? @db.Decimal(9, 4)

  @@unique([ano, instituicaoId])
  @@index([fonteDadosId])
}

// ---------- PNP, extração manual ----------

enum NivelPnp {
  REDE
  /// Só no painel orçamentário, que também agrega por região do país.
  REGIAO
  /// Só no painel orçamentário, que também agrega por estado.
  ESTADO
  INSTITUICAO
  CAMPUS
}

/// Um nó da hierarquia que o painel da PNP usa: a rede, uma instituição ou um câmpus
/// (ou estrutura, como reitoria). Os nomes vêm como o painel escreve ("Campus Venâncio
/// Aires", "IF FARROUPILHA"), por isso o vínculo com `Instituicao` e `Unidade` do
/// sistema é por nome normalizado e pode ficar vazio quando não casa: os dados da PNP
/// valem sozinhos, o vínculo só serve para cruzar com a matriz.
model PnpEstrutura {
  id                   Int      @id @default(autoincrement())
  nivel                NivelPnp
  /// Sigla como a PNP escreve; vazia na rede.
  instituicao          String   @default("")
  organizacaoAcademica String   @default("")
  regiao               String   @default("")
  estado               String   @default("")
  campus               String   @default("")
  municipio            String   @default("")

  instituicaoId  Int?
  instituicaoRef Instituicao? @relation(fields: [instituicaoId], references: [id])
  unidadeId      Int?
  unidade        Unidade?     @relation(fields: [unidadeId], references: [id])

  fatos          PnpFato[]
  fatosOrcamento PnpOrcamentoFato[]

  @@unique([nivel, instituicao, campus, municipio])
  @@index([instituicaoId])
  @@index([unidadeId])
}

/// Uma linha de um CSV do painel "Dados de Ensino" da PNP, como veio.
///
/// Em vez de uma tabela por arquivo (são 169, de 14 subabas, com colunas diferentes),
/// guarda-se o que é comum em colunas e o que é específico do arquivo em `valores`, com os
/// rótulos das colunas como a PNP escreve. Decimais com vírgula e percentuais em fração
/// (0,7258 = 72,58%) já estão convertidos em número.
///
/// Um mesmo indicador aparece em mais de uma subaba com o mesmo valor (a matrícula
/// total, por exemplo); cada linha guarda de qual subaba veio.
model PnpFato {
  id           BigInt       @id @default(autoincrement())
  fonteDadosId Int
  fonteDados   FonteDados   @relation(fields: [fonteDadosId], references: [id])
  estruturaId  Int
  estrutura    PnpEstrutura @relation(fields: [estruturaId], references: [id])

  /// "Dados Gerais", "Indicadores Acadêmicos", "Indicadores Legais" ou "Perfis de Matrículas".
  aba           String @db.VarChar(40)
  /// "Situação de Matrícula", "Eficiência Acadêmica", "Raça e Renda"...
  subaba        String @db.VarChar(80)
  /// A abertura ("Renda Familiar", "Eixo Tecnológico"...); vazia na tabela principal.
  dimensao      String @default("") @db.VarChar(80)
  valorDimensao String @default("") @db.VarChar(255)
  /// Colunas categóricas da linha juntas por " | " (ex.: "Evadidos | Abandono | Em fluxo").
  categoria     String @default("") @db.VarChar(255)
  anoBase       Int    @db.SmallInt
  /// Colunas numéricas (e textos como "(+3,66)") do arquivo, pelo rótulo original.
  valores       Json

  @@index([subaba, dimensao, anoBase, estruturaId])
  @@index([estruturaId, anoBase])
  @@index([fonteDadosId])
}

/// Uma linha de um CSV do painel "Dados Orçamentários" da PNP (execução, programação,
/// restos a pagar, descentralizações, gastos por matrícula equivalente...), como veio.
///
/// Mesmo desenho de `PnpFato`, com as colunas que só este painel tem: a "Relação do Órgão"
/// (órgão da UO, da UGE, TED's...), o mês e o tipo de valor da série mensal. Os valores estão
/// em reais e os percentuais em fração. O painel é por instituição (UO), região, estado e
/// rede: NÃO existe por câmpus.
model PnpOrcamentoFato {
  id           BigInt       @id @default(autoincrement())
  fonteDadosId Int
  fonteDados   FonteDados   @relation(fields: [fonteDadosId], references: [id])
  estruturaId  Int
  estrutura    PnpEstrutura @relation(fields: [estruturaId], references: [id])

  /// "Explorar Dados", "Gastos Totais da Rede", "Indicadores Orçamentários", "Panorama Orçamentário" ou "Série Histórica".
  aba           String @db.VarChar(60)
  /// Em "Explorar Dados" é o contexto (Execução do Exercício, Descentralizações...); nas demais repete a aba.
  subaba        String @db.VarChar(80)
  /// A abertura ("Ação Orçamentária", "Grupo de Despesas (GND)"...); vazia na tabela principal.
  dimensao      String @default("") @db.VarChar(120)
  valorDimensao String @default("") @db.VarChar(255)
  /// Órgão da UO, Órgão da UGE, TED's ou TED's do MEC.
  relacaoOrgao  String @default("") @db.VarChar(40)
  /// Só na série mensal.
  mes           String @default("") @db.VarChar(20)
  tipoValor     String @default("") @db.VarChar(40)
  anoBase       Int    @db.SmallInt
  valores       Json

  @@index([subaba, dimensao, anoBase, estruturaId])
  @@index([estruturaId, anoBase])
  @@index([fonteDadosId])
}

/// Uma linha de uma tabela do "Extrator" da PNP: os arquivos planos que a plataforma oferece para baixar
/// (dados gerais por curso e câmpus, situação de matrícula, evasão por curso, indicadores de gestão, pessoal,
/// panorama orçamentário). Cada arquivo tem colunas próprias; as de texto vão em \`dimensoes\` e as numéricas em
/// \`valores\`, pelo rótulo original. Diferente do painel (\`PnpFato\`), aqui os percentuais vêm em pontos
/// (38,55 = 38,55%) e o câmpus vem pelo nome ("nomeUnidadeRecente").
model PnpExtratorFato {
  id           BigInt     @id @default(autoincrement())
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  /// Pasta do arquivo no Extrator: "Dados acadêmicos", "Indicadores Acadêmicos"...
  grupo         String @db.VarChar(80)
  /// Nome do arquivo sem extensão: "DadosGerais", "TaxaEvasao"...
  tabela        String @db.VarChar(80)
  anoBase       Int    @db.SmallInt
  /// Sigla da instituição como a PNP escreve; vazia nas tabelas de rede.
  instituicao   String @default("") @db.VarChar(60)
  /// Câmpus ou estrutura; vazio quando a tabela é por instituição.
  unidade       String @default("") @db.VarChar(191)
  instituicaoId Int?
  unidadeId     Int?
  dimensoes     Json
  valores       Json

  @@index([tabela, anoBase, instituicao])
  @@index([instituicaoId, anoBase])
  @@index([unidadeId, anoBase])
  @@index([fonteDadosId])
}

/// Os microdados de matrículas (ou de eficiência acadêmica) da PNP, AGREGADOS POR CICLO DE CURSO.
///
/// O arquivo original tem uma linha por estudante (79 colunas, mais de 2,3 milhões por ano). O sistema não
/// guarda essas linhas: guarda o que o cálculo da matriz usa (ciclo, carga horária, datas, quantidade de
/// matrículas por situação e por faixa de renda). Isso preserva a análise e não leva dado pessoal para o
/// banco. O mesmo \`ciclo\` é o "Código ciclo" da 6ª fase da MDO, então os dois se cruzam diretamente (no IFSul
/// de 2025, os 1.352 ciclos, as cargas horárias e as datas coincidem em 100%).
model PnpMicrodadoCiclo {
  id           BigInt     @id @default(autoincrement())
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  /// "MATRICULAS" ou "EFICIENCIA".
  tipo    String @db.VarChar(20)
  anoBase Int    @db.SmallInt
  ciclo   String @db.VarChar(20)

  coInst              String  @default("") @db.VarChar(20)
  codUnidade          String  @default("") @db.VarChar(20)
  codUnidadeSistec    String  @default("") @db.VarChar(20)
  instituicao         String  @default("") @db.VarChar(60)
  unidadeEnsino       String  @default("") @db.VarChar(191)
  uf                  String  @default("") @db.VarChar(4)
  codMunicipio        String  @default("") @db.VarChar(12)
  cursoEmec           String  @default("") @db.VarChar(20)
  nomeCurso           String  @default("") @db.VarChar(255)
  tipoCurso           String  @default("") @db.VarChar(80)
  tipoOferta          String  @default("") @db.VarChar(60)
  modalidade          String  @default("") @db.VarChar(60)
  fonteFinanciamento  String  @default("") @db.VarChar(100)
  programa            String  @default("") @db.VarChar(150)
  eixo                String  @default("") @db.VarChar(120)
  subeixo             String  @default("") @db.VarChar(120)
  turno               String  @default("") @db.VarChar(30)
  formacaoProfessores Boolean @default(false)

  cargaHoraria       Int?
  cargaHorariaMinima Int?
  /// Fator de Esforço do Curso (Portaria Setec 146/2021); NÃO é o peso do curso da MDO.
  fatorEsforco       Decimal?  @db.Decimal(10, 4)
  inicio             DateTime? @db.Date
  fimPrevisto        DateTime? @db.Date
  vagas              Int?
  inscritos          Int?

  matriculas  Int
  atendidas   Int
  /// Matrículas por "Categoria da Situação | Situação": {"Concluintes | Concluída": 8186, ...}.
  porSituacao Json
  /// Matrículas por faixa de renda familiar per capita.
  porRenda    Json

  instituicaoId Int?
  unidadeId     Int?

  @@index([tipo, anoBase, instituicao])
  @@index([ciclo])
  @@index([unidadeId, anoBase])
  @@index([instituicaoId, anoBase])
  @@index([fonteDadosId])
}

/// Microdado financeiro da PNP: liquidações por unidade orçamentária, ação de governo e grupo de natureza de
/// despesa (soma das linhas repetidas). Não tem dado pessoal.
model PnpMicrodadoFinanceiro {
  id           BigInt     @id @default(autoincrement())
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  anoBase             Int     @db.SmallInt
  unidadeOrcamentaria String  @db.VarChar(20)
  acao                String  @db.VarChar(20)
  gnd                 String  @db.VarChar(10)
  /// Liquidações totais (exercício e restos a pagar não processados), em reais.
  liquidacoes         Decimal @db.Decimal(18, 2)

  @@index([anoBase, unidadeOrcamentaria])
  @@index([fonteDadosId])
}

/// Microdado de servidores da PNP, AGRUPADO por lotação, classe, jornada, titulação, carreira e vínculo (a
/// quantidade de servidores de cada grupo fica em \`registros\`). O arquivo original traz uma linha por
/// servidor, sem nome; o agrupamento impede reconhecer uma pessoa em lotações pequenas.
model PnpMicrodadoServidor {
  id           BigInt     @id @default(autoincrement())
  fonteDadosId Int
  fonteDados   FonteDados @relation(fields: [fonteDadosId], references: [id])

  anoBase          Int    @db.SmallInt
  codUnidade       String @default("") @db.VarChar(20)
  codUnidadeSistec String @default("") @db.VarChar(20)
  instituicao      String @default("") @db.VarChar(60)
  unidadeLotacao   String @default("") @db.VarChar(191)
  municipio        String @default("") @db.VarChar(120)
  codMunicipio     String @default("") @db.VarChar(12)
  regiao           String @default("") @db.VarChar(30)
  classe           String @default("") @db.VarChar(20)
  jornada          String @default("") @db.VarChar(20)
  rsc              String @default("") @db.VarChar(40)
  titulacao        String @default("") @db.VarChar(60)
  vinculoCarreira  String @default("") @db.VarChar(40)
  vinculoContrato  String @default("") @db.VarChar(40)
  vinculoProfessor String @default("") @db.VarChar(10)
  registros        Int

  @@index([anoBase, instituicao])
  @@index([fonteDadosId])
}

/// Peso efetivo por curso: o peso que a MDO realmente aplicou (já com o bônus de agropecuária), deduzido da Matrícula
/// Total publicada. Não é a coluna "Peso do Curso" da exportação, que erra em ~3% dos ciclos. Uma linha por
/// (ano de referência, tipo de curso, oferta, curso, CH mínima do MEC); a regra do FIC usa "*" em oferta e curso.
/// Cada linha guarda a fonte: de que arquivo foi deduzida e em quantos ciclos a dedução concorda.
model PesoEfetivoCurso {
  id                 Int         @id @default(autoincrement())
  /// Ciclo orçamentário da 6ª fase de onde a tabela foi deduzida (2027).
  anoReferencia      Int
  tipoCurso          String
  tipoOferta         String
  curso              String
  chMinimaMec        Int
  pesoEfetivo        Decimal     @db.Decimal(10, 4)
  /// O peso mais frequente na coluna "Peso do Curso" para esta chave, para mostrar onde a coluna difere.
  pesoColuna         Decimal     @db.Decimal(10, 4)
  ciclosObservados   Int
  ciclosConcordantes Int
  /// DEDUZIDO_DA_MATRICULA_TOTAL ou REGRA_FIC_SEM_CATALOGO.
  origem             String      @db.VarChar(40)
  /// Texto da fonte, mostrado na tela: arquivo, fase, quantos ciclos.
  fonte              String      @db.Text
  fonteDadosId       Int?
  fonteDados         FonteDados? @relation(fields: [fonteDadosId], references: [id])
  criadoEm           DateTime    @default(now())

  @@unique([anoReferencia, tipoCurso, tipoOferta, curso, chMinimaMec])
  @@index([anoReferencia, tipoCurso])
}

// ---------- Orçamento da União (LOA, PLOA e emendas) ----------

/// Um crédito orçamentário de uma instituição (uma linha do "Quadro dos Créditos Orçamentários" da LOA ou do PLOA, volume
/// de Detalhamento das Ações): ação, grupo de despesa, resultado primário, modalidade e fonte, com o valor. A LOA e o PLOA
/// só detalham até a instituição e o estado (localizador "No Estado do Rio Grande do Sul"): não existe valor por câmpus.
model OrcamentoLoaLinha {
  id                Int         @id @default(autoincrement())
  instituicaoId     Int
  instituicao       Instituicao @relation(fields: [instituicaoId], references: [id])
  /// "LOA" ou "PLOA".
  documento         String      @db.VarChar(10)
  /// Exercício a que o crédito se refere (2026 para a LOA 2026, 2027 para o PLOA 2027).
  exercicio         Int
  programa          String      @db.VarChar(10)
  /// Código da ação orçamentária (20RL, 2994, 21B3...).
  acao              String      @db.VarChar(10)
  acaoDescricao     String      @db.VarChar(255)
  localizador       String      @db.VarChar(10)
  /// Grupo de despesa: 1 pessoal, 3 outras despesas correntes, 4 investimentos.
  gnd               Int
  /// Resultado primário: 2 discricionária, 1 obrigatória, 6 emenda individual, 7 emenda de bancada, 8 emenda de comissão.
  resultadoPrimario Int
  modalidade        Int
  fonteRecurso      Int
  valor             Decimal     @db.Decimal(18, 2)
  /// Produto e meta física da ação ("Estudante matriculado (unidade)": 22.429).
  produto           String?     @db.VarChar(120)
  meta              Int?
  /// Texto da fonte, mostrado na tela: documento, volume e páginas.
  fonte             String      @db.Text
  criadoEm          DateTime    @default(now())

  @@index([instituicaoId, documento, exercicio, acao])
}

/// Total de uma instituição por documento e exercício, do "Quadro Síntese" (PLOA, LOA, Lei mais créditos, Empenhado).
model OrcamentoLoaTotal {
  id            Int         @id @default(autoincrement())
  instituicaoId Int
  instituicao   Instituicao @relation(fields: [instituicaoId], references: [id])
  /// "PLOA", "LOA", "LEI_CREDITOS" ou "EMPENHADO".
  documento     String      @db.VarChar(20)
  exercicio     Int
  valor         Decimal     @db.Decimal(18, 2)
  fonte         String      @db.Text
  criadoEm      DateTime    @default(now())

  @@unique([instituicaoId, documento, exercicio])
}

/// Emenda parlamentar individual com a instituição como unidade orçamentária ou beneficiária, do relatório do SIOP
/// ("Emendas Individuais", com valores indicados e impedidos). Uma linha por linha do relatório.
model EmendaParlamentar {
  id              Int         @id @default(autoincrement())
  instituicaoId   Int
  instituicao     Instituicao @relation(fields: [instituicaoId], references: [id])
  exercicio       Int
  autor           String      @db.VarChar(120)
  numeroEmenda    String      @db.VarChar(20)
  acao            String      @db.VarChar(10)
  acaoDescricao   String      @db.VarChar(255)
  localizador     String      @db.VarChar(120)
  beneficiario    String      @db.VarChar(255)
  valorAprovado   Decimal     @db.Decimal(18, 2)
  valorIndicado   Decimal     @db.Decimal(18, 2)
  valorImpedido   Decimal     @db.Decimal(18, 2)
  tipoImpedimento String      @db.VarChar(255)
  justificativa   String?     @db.Text
  fonte           String      @db.Text
  criadoEm        DateTime    @default(now())

  @@index([instituicaoId, exercicio])
}
